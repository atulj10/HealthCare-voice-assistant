# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Deepgram (streaming STT)
#   API key: https://console.deepgram.com/
# ------------------------------------------------------------------
DEEPGRAM_API_KEY=

# Deepgram streaming STT model and language. "multi" lets a single
# connection detect English and Hindi utterances throughout the call.
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_LANGUAGE=multi

# ------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------
# Primary LLM provider and the automatic fallback used when the primary
# hits a temporary error (rate limit, timeout, server error).
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=cerebras

# ------------------------------------------------------------------
# Gemini (primary LLM)
#   API key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# Cerebras (fallback LLM)
#   API key: https://cloud.cerebras.ai/
# ------------------------------------------------------------------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# ------------------------------------------------------------------
# ElevenLabs (TTS)
#   API key: https://elevenlabs.io/app/settings/api-keys
#
# ELEVENLABS_MODEL_ID must be a multilingual model that supports both
# English and Hindi, e.g. eleven_flash_v2_5 (low latency, recommended)
# or eleven_multilingual_v2 (highest quality).
#
# ELEVENLABS_VOICE_EN / ELEVENLABS_VOICE_HI must be valid ElevenLabs voice
# IDs (for a pre-made voice, copy it from the "Voices" tab in the app; for
# your own voice, copy the 32-character ID from your voice settings URL).
# Both are required - one per conversation language.
# ------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=

# Optional: latency optimization level for streaming TTS (0 = none, 3 = max)
# ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=1
